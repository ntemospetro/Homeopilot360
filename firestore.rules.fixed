rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Default deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Public packages/plans
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Therapists profiles
    match /therapists/{therapistId} {
      allow create: if true;
      allow read: if true; 
      allow update, delete: if isSignedIn() && (
        request.auth.uid == therapistId || 
        resource.data.authUid == request.auth.uid
      ) && (
        // Verhindert das Fälschen / Entführen der authUid
        !('authUid' in request.resource.data) ||
        request.resource.data.authUid == resource.data.authUid ||
        request.resource.data.authUid == request.auth.uid
      );
    }

    // Patient cases - Strict tenant isolation & immutable ownership
    match /cases/{caseId} {
      // 1. Lesen: Nur der tatsächliche Eigentümer
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.therapistId == request.auth.uid
      );

      // 2. Anlegen: Muss dem anlegenden Benutzer gehören
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.therapistId == request.auth.uid
      );

      // 3. Bearbeiten: Nur Eigentümer, Besitzerwechsel (ownerUid / therapistId) strikt verboten!
      allow update: if isSignedIn() && (
        (resource.data.ownerUid == request.auth.uid || resource.data.therapistId == request.auth.uid) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (!('therapistId' in resource.data) || request.resource.data.therapistId == resource.data.therapistId)
      );

      // 4. Löschen: Nur der Eigentümer
      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.therapistId == request.auth.uid
      );
    }

    // Therapist Stripe & token balances - Vertrauenswürdiger Server-Workflow
    match /therapist_balances/{therapistId} {
      // Lesen: Nur der berechtigte Therapeut
      allow read: if isSignedIn() && (
        request.auth.uid == therapistId ||
        resource.data.authUid == request.auth.uid
      );
      // Client-Writes strikt verboten: Guthaben wird ausschließlich serverseitig nach verifizierter Zahlung gutgeschrieben!
      allow create, update, delete: if false;
    }

    // Billing payment records - Revisionssicher & strikt isoliert
    match /billing_payments/{paymentId} {
      // 1. Lesen: Nur der eigene Therapeut darf seine Belege einsehen
      allow read: if isSignedIn() && resource.data.therapistId == request.auth.uid;

      // 2. Anlegen: Client darf allenfalls einen initialen 'pending'-Beleg für sich anlegen
      allow create: if isSignedIn() && (
        request.resource.data.therapistId == request.auth.uid &&
        request.resource.data.status in ['pending', 'initiated']
      );

      // 3. Ändern: Client-Updates strikt verboten!
      // Statusänderungen ('succeeded'), Betragsänderungen und Besitzübernahmen
      // dürfen AUSSCHLIESSLICH über den sicheren Stripe-Webhook / Server erfolgen.
      allow update: if false;

      // 4. Löschen: Finanzbelege dürfen clientseitig nicht gelöscht werden (Audit-Trail)
      allow delete: if false;
    }
  }
}
